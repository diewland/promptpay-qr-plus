<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_on_primary</item>
        <item name="colorPrimaryContainer">@color/md_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md_on_primary_container</item>
        <item name="colorSecondaryContainer">@color/md_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md_on_secondary_container</item>
        <item name="colorTertiaryContainer">@color/md_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/md_on_tertiary_container</item>
        <item name="android:colorBackground">@color/md_background</item>
        <item name="colorSurface">@color/md_background</item>
        <item name="colorSurfaceVariant">@color/md_surface_variant</item>
    </style>

    <style name="AppTheme.NoActionBar" />

    <style name="AppToolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/colorPrimary</item>
        <item name="titleTextColor">@android:color/white</item>
        <item name="navigationIconTint">@android:color/white</item>
    </style>

    <style name="InputField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <!-- Calculator keys -->
    <style name="CalcKey" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:textSize">28sp</item>
        <item name="cornerRadius">20dp</item>
    </style>

    <style name="CalcKey.Op">
        <item name="backgroundTint">@color/md_primary_container</item>
        <item name="android:textColor">@color/md_on_primary_container</item>
    </style>

    <style name="CalcKey.Del">
        <item name="backgroundTint">@color/md_tertiary_container</item>
        <item name="android:textColor">@color/md_on_tertiary_container</item>
    </style>

    <style name="CalcKey.Equal">
        <item name="backgroundTint">@color/md_primary</item>
        <item name="android:textColor">@color/md_on_primary</item>
    </style>

    <style name="CalcRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">horizontal</item>
    </style>

</resources>
