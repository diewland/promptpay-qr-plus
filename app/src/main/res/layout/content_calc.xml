<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:orientation="vertical"
    android:padding="12dp"
    tools:context="com.diewland.android.qr_pp_plus.CalcActivity"
    tools:showIn="@layout/activity_calc">

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Material3.CardView.Filled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="4dp"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="@color/md_surface_variant">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp">

            <TextView
                android:id="@+id/mod"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="32dp"
                android:textColor="?attr/colorPrimary"
                android:textSize="36sp"
                tools:text="+" />

            <EditText
                android:id="@+id/screen"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:cursorVisible="false"
                android:gravity="end|center_vertical"
                android:importantForAutofill="no"
                android:inputType="numberDecimal"
                android:maxLines="1"
                android:textColor="?attr/colorOnSurface"
                android:textSize="48sp"
                tools:text="1234.5" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

        <LinearLayout style="@style/CalcRow">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/pad_7"
                style="@style/CalcKey"
                android:text="7" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/pad_8"
                style="@style/CalcKey"
                android:text="8" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/pad_9"
                style="@style/CalcKey"
                android:text="9" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/pad_del"
                style="@style/CalcKey.Del"
                android:text=""
                android:contentDescription="Delete"
                app:icon="@drawable/ic_backspace"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="28dp"
                app:iconTint="@color/md_on_tertiary_container" />
        </LinearLayout>

        <LinearLayout style="@style/CalcRow">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/pad_4"
                style="@style/CalcKey"
                android:text="4" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/pad_5"
                style="@style/CalcKey"
                android:text="5" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/pad_6"
                style="@style/CalcKey"
                android:text="6" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/pad_divide"
                style="@style/CalcKey.Op"
                android:text="÷" />
        </LinearLayout>

        <LinearLayout style="@style/CalcRow">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/pad_1"
                style="@style/CalcKey"
                android:text="1" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/pad_2"
                style="@style/CalcKey"
                android:text="2" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/pad_3"
                style="@style/CalcKey"
                android:text="3" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/pad_multiply"
                style="@style/CalcKey.Op"
                android:text="x" />
        </LinearLayout>

        <LinearLayout style="@style/CalcRow">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/pad_dot"
                style="@style/CalcKey"
                android:text="." />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/pad_0"
                style="@style/CalcKey"
                android:text="0" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/pad_minus"
                style="@style/CalcKey.Op"
                android:text="-" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/pad_add"
                style="@style/CalcKey.Op"
                android:text="+" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pad_equal"
            style="@style/CalcKey.Equal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:text="=" />

</LinearLayout>
